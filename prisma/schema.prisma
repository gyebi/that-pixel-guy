// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id        String   @id @default(cuid())
  name      String
  initials  String
  email     String   @unique
  image     String?
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shoots Shoot[]
}

model Shoot {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  photos    Photo[]
  galleries Gallery[]
}

model Photo {
  id               String   @id @default(cuid())
  shootId          String
  originalFilename String
  mediaKey         String
  width            Int
  height           Int
  altText          String
  sortOrder        Int      @default(0)
  status           String   @default("Visible")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shoot         Shoot          @relation(fields: [shootId], references: [id], onDelete: Cascade)
  galleryPhotos GalleryPhoto[]

  @@index([shootId])
}

model Gallery {
  id               String    @id @default(cuid())
  shootId          String
  name             String
  expiresOn        DateTime?
  downloadsEnabled Boolean   @default(false)
  status           String    @default("Active")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  shoot  Shoot          @relation(fields: [shootId], references: [id], onDelete: Cascade)
  photos GalleryPhoto[]

  @@index([shootId])
}

model GalleryPhoto {
  id        String @id @default(cuid())
  galleryId String
  photoId   String
  position  Int

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  photo   Photo   @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([galleryId, photoId])
  @@unique([galleryId, position])
  @@index([photoId])
}

model AdminSession {
  id                String    @id @default(cuid())
  sessionIdHash     String    @unique
  uid               String
  createdAt         DateTime  @default(now())
  lastActivityAt    DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?

  @@index([uid, revokedAt])
  @@index([absoluteExpiresAt])
}

model SiteSettings {
  id             String   @id @default("site") @db.VarChar(32)
  businessName   String   @db.VarChar(120)
  publicEmail    String   @db.VarChar(254)
  phoneNumber    String?  @db.VarChar(32)
  whatsAppNumber String?  @db.VarChar(32)
  location       String?  @db.VarChar(160)
  instagramUrl   String?  @db.VarChar(2048)
  facebookUrl    String?  @db.VarChar(2048)
  pinterestUrl   String?  @db.VarChar(2048)
  tikTokUrl      String?  @db.VarChar(2048)
  youTubeUrl     String?  @db.VarChar(2048)
  revision       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HomepageContent {
  id              String   @id @default("homepage") @db.VarChar(32)
  heroEyebrow     String   @db.VarChar(120)
  heroHeading     String   @db.VarChar(180)
  heroIntro       String   @db.VarChar(600)
  heroCtaLabel    String   @db.VarChar(80)
  introEyebrow    String   @db.VarChar(120)
  introHeading    String   @db.VarChar(180)
  introBody       String   @db.VarChar(800)
  introCtaLabel   String   @db.VarChar(80)
  workEyebrow     String   @db.VarChar(120)
  workHeading     String   @db.VarChar(180)
  workCtaLabel    String   @db.VarChar(80)
  servicesEyebrow String   @db.VarChar(120)
  servicesHeading String   @db.VarChar(180)
  servicesBody    String   @db.VarChar(800)
  contactEyebrow  String   @db.VarChar(120)
  contactHeading  String   @db.VarChar(180)
  contactCtaLabel String   @db.VarChar(80)
  revision        Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
