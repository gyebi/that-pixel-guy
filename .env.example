# Application runtime: pooled Neon PostgreSQL connection.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER-HOST/pixel-guy?sslmode=require"

# Production only: comma-separated, exact canonical HTTPS browser origins allowed
# to make cookie-authenticated admin mutations. No spaces, paths, trailing slash,
# wildcard, credentials, query/hash, duplicate entries, or non-HTTPS origins.
# Configure the Firebase App Hosting public hostname(s), never a Cloud Run run.app
# hostname unless that hostname is an intentional public browser origin.
ADMIN_TRUSTED_ORIGINS="https://your-backend--your-project.us-central1.hosted.app"

# Prisma migrations only: direct Neon PostgreSQL connection for the development branch.
# These values are required by every `prisma migrate` command and are never used by the app.
MIGRATION_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT-HOST/pixel-guy?sslmode=require"

# Exact direct hostname for the independently verified Neon development branch.
# Store this in protected CI/development configuration; do not derive it from MIGRATION_DATABASE_URL.
MIGRATION_DEVELOPMENT_HOST="approved-development-host.neon.tech"
